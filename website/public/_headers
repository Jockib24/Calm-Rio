# CalmRio — HTTP Caching Headers
# For Cloudflare Pages / Netlify / custom hosts
# (GitHub Pages ignores _headers; configure via custom domain + Cloudflare)

# Images — immutable, 1 year
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# CSS (hashed by Vite) — immutable, 1 year
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

# JS (hashed by Vite) — immutable, 1 year
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts — 1 year
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML — revalidate, 1 hour
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Root index
/
  Cache-Control: public, max-age=3600, must-revalidate

# Favicon and manifest — 1 month
/favicon.*
  Cache-Control: public, max-age=2592000
/site.webmanifest
  Cache-Control: public, max-age=2592000
